# Fork of OpenGothic is a separate repository (kaifaty/OpenGothic)
/OpenGothic/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets and local config (.env.example is the template)
.env
.env.*
!.env.example
*.local.toml
secrets/

# Runtime data
*.log
*.sqlite
*.sqlite3
data/

# OS
.DS_Store

# Game data: never in the repository (needs your own copy of the game)
/game/
*.vdf
*.VDF

# Claude Code: per-session worktrees and personal settings
.claude/worktrees/
.claude/settings.local.json

# OpenGothic runtime files (written to the directory the game was started from)
Gothic.ini
log.txt
*.sav

# Local agent rules (not shared)
/AGENTS.md
/tts-samples/
