# Archery: the same scenes filmed twice, the bow as Gothic II has it (the auto aim and the dice: film.sh's "off"
# take, OPENGOTHIC_MANUALAIM=0 OPENGOTHIC_NPCAIM=0) and aimed by hand (docs/manual-aim.md); each `rec` is a
# beat of the short. The two take their shots with their own keys (`off:` / `on:` lines): the auto aim
# shoots on action + forward, the hand lets go of the action key; the shots fall on the same frames.
# The hero keeps the untrained animations. The runner first, the bow still on the back
cheat god
set time 12 0
overlay off
give ItRw_Arrow 500
equip ItRw_Bow_M_01
stats str 60 dex 60 bow 60
# lead: two paladins with crossbows 7.5 m off shoot at the hero running to and fro across them (the dice: at
# where he was; by hand: ahead of him), from behind him: a hit stops him
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
turn 210
wait 500
clear 3000
immortal player on
arc PAL_255_RITTER 2 750 22
wait 300
stats npc PAL_255_RITTER talent auto
archer all at player
cam follow 330 170 172
cam look 120
wait 2000
rec lead
hold left 2400
wait 2600
hold right 2400
wait 2600
hold left 2400
wait 2600
stop
archer off
clear 3000

off: walkmode walk

# draw: a bandit 10 m off on Onar's field, the hero from the side: the hand draws, holds, lets go
goto NW_BIGFARM_VORPOSTEN1_01_RIGHTFIELD_02
turn 210
wait 500
clear 3000
insert BDT_1003_BANDIT_M
wait 300
immortal BDT_1003_BANDIT_M on
pin BDT_1003_BANDIT_M 1000 0 0
on: aimat BDT_1003_BANDIT_M body
tap bow
wait 1500
cam follow 210 140 90
cam look 135
wait 500
rec draw
press action
wait 1900
off: tap forward
on: release action
wait 1000
off: release action
wait 1300
stop

# head: three shots at the bandit's head from the game's camera (the crosshair), a master now (the dice: at
# the middle, it decides; 10 m off a master's always hits)
stats str 150 dex 150 bow 100
on: aimat BDT_1003_BANDIT_M head
cam game
ui on                             # the crosshair (the auto aim: the focus' name and health)
wait 1000
rec head
press action
wait 1500
off: tap forward
on: release action
wait 1000
on: press action
wait 1200
off: tap forward
on: release action
wait 1000
on: press action
wait 1200
off: tap forward
on: release action
wait 1600
off: release action
stop
ui off

# cant: the hero from in front: the wheel cants the bow (the auto aim: it zooms the camera)
stats str 60 dex 60 bow 60
on: aimat BDT_1003_BANDIT_M body
cam front 240 150
wait 1000
rec cant
press action
wait 900
wheel -1
wait 1400
off: tap forward
on: release action
wait 1000
off: release action
wait 1200
stop
on: wheel 1
pin off
clear 3000
wait 300

# walk: from the side, steps with the bow drawn (the auto aim: the bow goes down to walk)
on: aimat ahead 1500 140
cam follow 250 130 90
cam look 120
wait 1000
rec walk
press action
wait 1100
off: release action
hold forward 2600
wait 2800
release action
wait 1200
stop
on: tap parade
wait 800
tap bow
wait 1500

# peek: behind a house's corner in the harbour, from the game's camera: the side step held leans out past it,
# the camera with the head
goto NW_CITY_MERCHANT_PATH_09
wait 500
corner right go 5
on: aimat ahead 2000 150
tap bow
wait 1500
cam game
ui on
wait 500
rec peek
press action
wait 900
hold right 3200
wait 3600
stop
ui off
on: tap parade                    # the string let down: no arrow into the wall
wait 300
release action
wait 800
tap bow
wait 1500
