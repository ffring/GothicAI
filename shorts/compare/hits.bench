# Hits: the same arrows filmed twice, the body physics off (OpenGothic's hit and death animations, the arrow
# gone at the hit) and on (living bodies, arrow reactions, stuck arrows, ragdoll); each `rec` is a beat of the
# short, the two takes stacked (shorts/compare/film.sh, cut.py). `off:` lines run in the "off" take only, the
# flinch (our animation of a blow) is off there too (hits.json "off_env"). Daylight, no AI server.
cheat god
set time 12 0
overlay off
manual on
equip ItRw_Bow_L_01
give ItRw_Arrow 100
stats str 150 dex 150 bow 100
off: ragdoll off
off: living off
off: arrow feature off
off: sticking feature off
tap bow
wait 1500

# stick: a bandit 8 m off on Onar's field, the sun on his face; three arrows, the first slowed down
goto NW_BIGFARM_FIELD_01
clear 3000
face 90
insert BDT_1013_BANDIT_L
put BDT_1013_BANDIT_L 800 0
watch BDT_1013_BANDIT_L
stats npc watched hp 10000 hpmax 10000
cam follow 190 160 -40
cam look 120
aimat watched body
wait 1200
rec stick
slowmo 2
volley 1 250
slowmo 1
aimat watched leg
volley 1 200
aimat watched limb
volley 1 200
wait 800
stop

# charge: he comes at the hero with the arrows in him; the last one drops him on the run
cam cut
cam follow 330 130 -40
cam look 110
aimat watched body
rec charge
freeze watched off
fight watched player
wait 1600
stats npc watched hp 1
volley 1 150
wait 3000
stop
aimat off

# slope: the bandit 6 m up the slope over the sea by the hunters' camp, the arrow kills, the body comes down;
# the camera on the open side of the slope, the frame held
goto NW_CITY_JAEGER_03
clear 2500
face uphill
insert BDT_1013_BANDIT_L
put BDT_1013_BANDIT_L 600 0
stats npc BDT_1013_BANDIT_L hp 1
watch BDT_1013_BANDIT_L
cam cut
cam follow 350 150 -60
cam look 100
aimat watched body
wait 1200
rec slope
cam hold
volley 1 300
wait 4500
stop
aimat off

# wolf: the same slope, a wolf instead of the bandit (the bandit's body goes: `clear` keeps the watched one)
watch player
goto NW_CITY_JAEGER_03
clear 2500
face uphill
insert Wolf
put Wolf 600 0
stats npc Wolf hp 1
watch Wolf
cam cut
cam follow 330 120 -60
cam look 60
aimat watched body
wait 1200
rec wolf
cam hold
volley 1 300
wait 4500
stop
aimat off
