# Bodies: the same scenes filmed twice, the animation work off (OpenGothic as it was) and on; each `rec`
# is a beat of the short, the two takes stacked (shorts/compare/film.sh, cut.py). Daylight, no AI server.
cheat god
set time 12 0
overlay off

# feet: standing across a 24 degree slope on the way to the lighthouse, then a few steps along it
goto NW_CITY_TO_LIGHTHOUSE_07
clear 2500
face across
walkmode walk
cam follow 185 60 15
cam look 62
wait 1500
rec feet
wait 2500
hold forward 1800
wait 2200
stop

# four legs: a wolf standing across the same slope
goto NW_CITY_TO_LIGHTHOUSE_07
face across
transform Wolf
wait 1500
cam follow 230 70 50
cam look 40
wait 800
rec wolf
wait 3000
stop
transform back
wait 1000

# gaze: a farmer on Onar's field notices the hero walking up from his right
goto NW_BIGFARM_FIELD_01
clear 3000
face 90
insert BAU_916_BAUER
freeze BAU_916_BAUER              # stands there, the routine does not take him away
watch BAU_916_BAUER
put BAU_916_BAUER 300 0
cam follow 290 170 45
cam look 155
walkmode walk
place 900 -80
wait 1500
rec gaze
approach BAU_916_BAUER
wait 6500
stop

# lean: a slalom on the field
watch player
goto NW_BIGFARM_FIELD_01
clear 3000                        # the farmer goes
face 90
walkmode run
cam follow 320 140 10
cam look 110
wait 800
rec lean
hold forward 5200
hold turnl 900
wait 900
hold turnr 1800
wait 1800
hold turnl 1800
wait 1800
stop
release all
