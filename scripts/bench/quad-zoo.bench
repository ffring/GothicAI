# Four-legged foot IK on different creatures: small, big, lizards, insects; up and across slopes
cheat god
set time 12 0
view clean
transform Molerat
wait 500
foreach slope 15 30 2
  cam auto 300 50
  face uphill
  walkmode run
  wait 300
  rec Molerat_$I_up
  hold forward 1500
  wait 1500
  stop
  face across
  walkmode walk
  wait 300
  rec Molerat_$I_across
  hold forward 1500
  wait 1500
  stop
end
transform back
wait 300
