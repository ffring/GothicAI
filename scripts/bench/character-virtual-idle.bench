# Load the hero's standing stair save with CHARACTER_VIRTUAL=1. No actor input.
# `initial` runs before the first native tick in both main and this branch.
character initial
# The archived stair fixture has a wolf outside its original 22m freeze radius.
# Keep that actor in place so its attack cannot become measured idle motion.
freeze id:984
npccharacter trace player
rec idle_10s
# Ordinary commands first run at 33ms; the remaining 967ms ends at exactly 1s.
wait 967
character snapshot first_1s
wait 9000
character snapshot idle_10s
stop
npccharacter trace off
