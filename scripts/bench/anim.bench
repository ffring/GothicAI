# Transitions between animations of the hero on a flat floor: start and stop, walk to run, turning on
# the spot, strafing, walking backwards, jumps, sneaking, fists drawn: attacks, a combo, moving
cheat god
set time 12 0
view clean
goto NW_XARDAS_TOWER_IN1_26   # the flat floor in Xardas' tower
cam follow 320 90 90
walkmode run
wait 800
rec startstop          # run, stop, a short run, stop
wait 500
hold forward 1200
wait 1800
hold forward 500
wait 1500
stop
goto NW_XARDAS_TOWER_IN1_26
walkmode walk
wait 800
rec walkrun            # walk, run without stopping, walk again, stop
hold forward 3600
wait 1200
walkmode run
wait 1000
walkmode walk
wait 1400
wait 1200
stop
goto NW_XARDAS_TOWER_IN1_26
walkmode run
wait 800
rec turn               # turning on the spot: left, right, a short left
hold turnl 1000
wait 1400
hold turnr 1000
wait 1400
hold turnl 300
wait 1000
stop
rec strafe             # strafe left, right, walk backwards
hold left 900
wait 1300
hold right 900
wait 1300
hold back 1000
wait 1400
stop
goto NW_XARDAS_TOWER_IN1_26
wait 800
rec jump               # a jump from standing, then from running
tap jump
wait 2000
hold forward 1800
wait 700
tap jump
wait 2200
stop
goto NW_XARDAS_TOWER_IN1_26
walkmode sneak
wait 800
rec sneak              # sneak, stop, sneak
hold forward 1200
wait 1600
hold forward 800
wait 1400
stop
walkmode run
goto NW_XARDAS_TOWER_IN1_26
wait 800
rec fists              # draw the fists, attack, a combo, block, a side attack, run a bit, put them away
tap weapon
wait 1500
press action           # classic controls: action held and a direction
tap forward
wait 1200
tap forward
wait 350
tap forward
wait 350
tap forward
wait 1500
tap back
wait 1000
tap left
wait 1200
release action
wait 500
hold forward 1000
wait 1400
hold left 700
wait 1100
tap weapon
wait 1800
stop
