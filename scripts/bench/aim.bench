# Aim: the hero draws a bow at a sheep hung at different heights (pin): level, up, steep up (another aim
# pose of the game), to the side; the same "up" with aim off; a crossbow; on a slope (the feet stay on
# the ground while aiming); down from three ledges and from a ship's deck steeply down; a fire bolt;
# shoots three times up (the reload swings the arrow: the turn holds; the sheep does not live through
# it); last leans over a gallery's edge to shoot one right at the foot of the wall. The game's aim: the
# manual one (on by default) off
manual off
cheat god
set time 12 0
view clean
goto NW_XARDAS_TOWER_VALLEY_091   # flat open ground
face -106                         # a rock behind, open in front
wait 500
equip ItRw_Bow_L_01
give ItRw_Arrow 50
insert Sheep
wait 300
tap bow
wait 1500
cam follow 380 110 75
cam look 120
pin SHEEP 1200 0 0
wait 300
rec level
press action
wait 2500
release action
wait 800
pin SHEEP 1000 0 550
wait 300
rec up
press action
wait 2500
release action
wait 800
pin SHEEP 500 0 750
wait 300
rec steep
press action
wait 2500
release action
wait 800
pin SHEEP 1000 25 300
wait 300
rec side
press action
wait 2500
release action
wait 800
pin SHEEP 1000 0 550
wait 300
aim off
rec up_off
press action
wait 2500
release action
wait 800
stop
aim on
tap bow
wait 1500
equip ItRw_Crossbow_L_01
give ItRw_Bolt 50
tap bow
wait 2000
goto NW_XARDAS_TOWER_VALLEY_091
face -106
wait 500
pin SHEEP 1000 0 550
wait 300
rec cbow
press action
wait 600
anims
wait 2500
release action
wait 800
stop
tap bow
wait 1500
equip ItRw_Bow_L_01
pin off
goto NW_FOREST_PATH_16              # a 21 degree slope
wait 500
face across
tap bow
wait 1500
cam follow 300 60 90
pin SHEEP 1000 0 300
wait 300
rec slope
press action
wait 600
anims
wait 2500
release action
wait 800
stop
cam follow 380 140 70
goto NW_XARDAS_TOWER_VIEW_01      # ledges found by `ledges`: a target 4 m below, 14 m away (17 deg)
face 157.5
wait 500
pin SHEEP 1400 0 -423
wait 300
rec down17
press action
wait 2500
release action
wait 800
stop
goto NW_XARDAS_TOWER_VALLEY_03_C  # 10 m below (36 deg)
face 90
wait 500
pin SHEEP 1400 0 -1032
wait 300
rec down36
press action
wait 2500
release action
wait 800
stop
goto NW_XARDAS_TOWER_VALLEY_02    # 14 m below (46 deg): past 45 the game takes its aim-down pose
face 135
wait 500
pin SHEEP 1400 0 -1446
wait 300
rec down46
press action
wait 2500
release action
wait 800
stop
goto SHIP_DECK_23                 # a ship in the harbour, 3.8 m down from the deck to the quay; each
wait 500                          # raise of the bow steps the hero 10 cm forward: back to the edge
edge 112.5                        # (35 cm from it) every time
cam follow 330 60 90
cam look 40
wait 300
pin SHEEP 265 0 -382              # 2.3 m out from the hull: 70 deg down, the game's aim-down pose
wait 300
rec deck70
press action
wait 2500
release action
wait 800
stop
goto SHIP_DECK_23
wait 500
edge 112.5
wait 300
pin SHEEP 165 0 -382              # 1.3 m out: 80 deg, the hero leans over the bulwark (closer the hull
                                  # bulges under the deck: nothing to see; see the gallery at the end)
wait 300
rec deck80
press action
wait 2500
release action
wait 800
stop
pin off
tap bow
wait 1500
equip ItRu_FireBolt
tap spell
wait 1500
goto NW_XARDAS_TOWER_VALLEY_091
face -106
cam follow 380 110 75
wait 500
pin SHEEP 1000 0 550
wait 300
rec spell            # a fire bolt up: the upper body bends while casting
press action
wait 900
tap forward
wait 1800
release action
wait 800
stop
tap spell
wait 1500
tap bow
wait 1500
goto NW_XARDAS_TOWER_VALLEY_091
face -106
wait 500
pin SHEEP 1000 0 550
wait 300
rec shoot
press action
wait 1200
tap forward
wait 1200
tap forward
wait 1200
tap forward
wait 1200
release action
wait 800
stop
tap bow                           # a gallery in Xardas' tower (found by `walls`): a sheep 5.6 m below,
wait 1500                         # 1 m out from the wall's foot (78 deg). The head does not see it,
goto NW_XARDAS_TOWER_IN1_20       # leaning over the edge does: with the aim the focus takes it, the hero
wait 500                          # leans over and shoots it; without, no focus
edge 67.5
tap bow
wait 1500
face 67.5
cam follow 260 110 100
cam look 110
insert Sheep                      # the first one is dead by now (`SHEEP`: the living one)
wait 300
aim off
pin SHEEP 5000 0 0              # out of the focus range: a focus once taken sticks (no ray then)
wait 300
pin SHEEP 135 0 -558
wait 300
cansee SHEEP
rec gallery_off
press action
wait 1500
anims
release action
wait 800
stop
aim on
goto NW_XARDAS_TOWER_IN1_20       # back at the edge (raising the bow stepped forward)
wait 500
edge 67.5
wait 300
face 67.5
pin SHEEP 5000 0 0
wait 300
pin SHEEP 135 0 -558
wait 300
cansee SHEEP
rec gallery
press action
wait 1500
anims
hp SHEEP
tap forward
wait 1500
hp SHEEP
release action
wait 800
stop

# MANUAL_VISIBLE_BEGIN
# Self-contained manual checks, also runnable alone by extracting from this marker to EOF.
# All three targets are in open sight: the lean must stay zero, while aim error and bend retain
# their previous behavior. The actual game camera/crosshair follows mouse input, as on the roof.
cheat god
set time 12 0
view full
overlay off
pin off
aimat off
disarm
goto NW_XARDAS_TOWER_VALLEY_091
cheat full
ani player S_RUN
face -106
wait 500
clear 2500
equip ItRw_Bow_L_01
give ItRw_Arrow 50
stats str 120 dex 120 bow 100 talent 0
insert Sheep
wait 300
immortal SHEEP on
manual on
aim on
draw bow
wait 1500
cam game
ui on
sight SHEEP
# A visible target at ground level, slightly below the standing head.
pin SHEEP 1200 0 0
wait 300
aimat SHEEP body mouse
rec manual_visible
press action
wait 2500
cansee SHEEP
anims
shot manual_visible_drawn
wait 100
release action
wait 1500
stop
# Upward aim: the target remains in open sight.
pin SHEEP 1000 0 550
wait 300
aimat SHEEP body mouse
rec manual_up
press action
wait 2500
cansee SHEEP
anims
shot manual_up_drawn
wait 100
release action
wait 1500
stop
# Horizontal look near standing-head height; keep the same target visible in the frame.
pin SHEEP 1200 0 115
wait 300
aimat ahead 1200 160 mouse
rec manual_straight
press action
wait 2500
cansee SHEEP
anims
shot manual_straight_drawn
wait 100
release action
wait 1500
stop
aimat off
pin off
sight off
ui off
