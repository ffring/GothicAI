# One authored harbour BENCH pinned by its nearest exact stock waypoint.
# Every rejected candidate and the actual chosen geometry are recorded in events.jsonl.
# Native grounded AI_GoToPoint -> AI_UseMob -> native stand. One fixed clear view.
seed 73013
cheat god
set time 12 0
off: npccharacter off
on: npccharacter on
view full
overlay off
npccharacter seat NW_CITY_HABOUR_06_C
wait 1000
rec npc_seat_and_rise
npccharacter sit
wait 5500
npccharacter snapshot seated
npccharacter stand
wait 5500
npccharacter end
npccharacter snapshot standing
stop
