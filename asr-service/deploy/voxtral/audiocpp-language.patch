+std::shared_ptr<const std::vector<uint8_t>> VoxtralRealtimeTokenizer::language_suppression(
+    const std::string & language) const {
+    const auto letters = letters_for_language(language);
+    if (!letters.has_value()) {
+        return nullptr;
+    }
+    std::lock_guard<std::mutex> lock(impl_->suppression_mutex);
+    auto & mask = impl_->suppression[static_cast<size_t>(*letters)];
+    if (mask == nullptr) {
+        auto built = std::make_shared<std::vector<uint8_t>>(
+            static_cast<size_t>(impl_->assets->config.text.vocab_size), 0);
+        for (const auto & [token_id, bytes] : impl_->id_to_bytes) {
+            if (!token_fits(bytes, *letters)) {
+                (*built)[static_cast<size_t>(token_id)] = 1;
+            }
+        }
+        mask = std::move(built);
+    }
+    return mask;
+}
