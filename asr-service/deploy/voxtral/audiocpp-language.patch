+// Letters a language is written in. Russian takes its 33 letters only, so neither Latin nor the
+// letters of its Cyrillic neighbours (і, ї, є, ў, ј...) slip into a transcript.
+enum class LetterSet { Russian, Latin };
+
+std::optional<LetterSet> letters_for_language(const std::string & language) {
+    static const std::unordered_set<std::string> latin = {"en", "fr", "es", "de", "it", "pt", "nl"};
+    // zh, ja, ko, ar and hi mix their own script with Latin too freely to mask one of them.
+    static const std::unordered_set<std::string> unmasked = {"", "auto", "zh", "ja", "ko", "ar", "hi"};
+    if (language == "ru") {
+        return LetterSet::Russian;
+    }
+    if (latin.count(language) != 0) {
+        return LetterSet::Latin;
+    }
+    if (unmasked.count(language) != 0) {
+        return std::nullopt;
+    }
+    throw std::runtime_error(
+        "VoxTral realtime language must be auto or one of en fr es de it pt nl ru zh ja ko ar hi, got: " + language);
+}
+
+// Digits, ASCII punctuation, Latin-1 punctuation (°, ¿), general punctuation (— …), currency and
+// letterlike symbols (№) fit every language; letters only their own. Quotes fit none: held off a
+// foreign word, the model quotes the speech instead of writing it down («Хи, бро!»).
+bool codepoint_fits(uint32_t cp, LetterSet letters) {
+    if (cp == '"' || cp == 0xAB || cp == 0xBB || (cp >= 0x201C && cp <= 0x201F)) {
+        return false;
+    }
+    if (cp < 0x80) {
+        const uint32_t lower = cp | 0x20;
+        return lower < 'a' || lower > 'z' || letters == LetterSet::Latin;
+    }
+    if ((cp >= 0xA0 && cp <= 0xBF) || (cp >= 0x2000 && cp <= 0x206F) || (cp >= 0x20A0 && cp <= 0x20CF) ||
+        (cp >= 0x2100 && cp <= 0x214F)) {
+        return true;
+    }
+    if (letters == LetterSet::Russian) {
+        return (cp >= 0x410 && cp <= 0x44F) || cp == 0x401 || cp == 0x451;
+    }
+    return cp >= 0xC0 && cp <= 0x24F;
+}
+
+// Tekken pieces are raw bytes and may cut a character. Continuation bytes that open a piece finish
+// a character an earlier piece began, so they pass; a piece cut at its end passes when its lead
+// byte opens a block that holds fitting characters. A split character can thus slip through, but
+// the vocabulary has whole tokens for these letters and only a handful of pieces end inside one.
+bool token_fits(const std::string & bytes, LetterSet letters) {
+    size_t i = 0;
+    while (i < bytes.size() && (static_cast<unsigned char>(bytes[i]) & 0xC0) == 0x80) {
+        ++i;
+    }
+    while (i < bytes.size()) {
+        const auto lead = static_cast<unsigned char>(bytes[i]);
+        if ((lead & 0xC0) == 0x80 || lead >= 0xF8) {
+            return false;
+        }
+        const size_t length = lead < 0x80 ? 1 : lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4;
+        if (i + length > bytes.size()) {
+            if (lead == 0xC2 || lead == 0xE2) {
+                return true;
+            }
+            return letters == LetterSet::Russian ? (lead == 0xD0 || lead == 0xD1) : (lead >= 0xC3 && lead <= 0xC9);
+        }
+        uint32_t cp = length == 1 ? lead : (lead & (0xFFu >> (length + 1)));
+        for (size_t k = 1; k < length; ++k) {
+            const auto next = static_cast<unsigned char>(bytes[i + k]);
+            if ((next & 0xC0) != 0x80) {
+                return false;
+            }
+            cp = (cp << 6) | (next & 0x3Fu);
+        }
+        if (!codepoint_fits(cp, letters)) {
+            return false;
+        }
+        i += length;
+    }
+    return true;
+}
