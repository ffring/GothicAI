[Unit]
Description=Gothic AI: Voxtral Mini 4B Realtime (audio.cpp, HTTP port 47830)
After=network-online.target

[Service]
# VOXTRAL_HOST: the address to listen on (the server's VPN address)
EnvironmentFile=-%h/gothic-ai/gothic-ai.env
ExecStart=%h/gothic-ai/voxtral/run.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
