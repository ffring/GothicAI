[Unit]
Description=Gothic AI: VoxCPM2 TTS (audio.cpp + WebSocket bridge, port 47831)
After=network-online.target

[Service]
# VOXCPM_HOST: the address to listen on (the server's VPN address)
EnvironmentFile=-%h/gothic-ai/gothic-ai.env
ExecStart=%h/gothic-ai/voxcpm/run.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
