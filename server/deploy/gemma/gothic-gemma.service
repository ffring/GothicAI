[Unit]
Description=Gothic AI: quick model of fights (Gemma 4 12B on llama.cpp, HTTP port 47834)
After=network-online.target

[Service]
# GEMMA_HOST: the address to listen on (the server's VPN address)
EnvironmentFile=-%h/gothic-ai/gothic-ai.env
ExecStart=%h/gothic-ai/gemma/run.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
